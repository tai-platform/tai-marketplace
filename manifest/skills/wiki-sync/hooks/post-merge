#!/bin/sh
# tai wiki-sync
command -v copilot >/dev/null 2>&1 || exit 0

default=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
default=${default:-main}
[ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "$default" ] || exit 0

sha=$(git rev-parse HEAD)
gitdir=$(git rev-parse --git-dir)

lock="$gitdir/wiki-sync.lock"
find "$lock" -mmin +30 -delete 2>/dev/null
[ -e "$lock" ] && exit 0

repo=$(git remote get-url origin | sed -E 's#^(git@github.com:|https://github.com/)##; s#\.git$##')
touch "$lock"
nohup sh -c "copilot --agent github-wiki -p 'Sync the wiki for $repo at $sha' --allow-all-tools; rm -f '$lock'" \
  </dev/null >"$gitdir/wiki-sync.log" 2>&1 &
exit 0
